# Configure an OIDC application with your identity provider. Do not commit real secrets.
[auth]
redirect_uri = "https://YOUR_APP_HOST/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_SECRET"
client_id = "YOUR_OIDC_CLIENT_ID"
client_secret = "YOUR_OIDC_CLIENT_SECRET"
server_metadata_url = "YOUR_OIDC_DISCOVERY_URL"
